{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/affiliate-disclosure/",
      "destination": "/disclosure/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "enthusiastreview.com"
        }
      ],
      "destination": "https://www.enthusiastreview.com/:path*",
      "permanent": true
    }
  ]
}
