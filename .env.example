# Copy to .env and fill in. .env is gitignored — never commit real credentials.
# Used only by `npm run images:fetch`, which finds each product's exact Amazon listing
# through the Amazon Creators API (official SDK) and writes ASINs + photos to
# src/data/catalog.json. Nothing at build time or runtime reads these.
# Get them at https://affiliate-program.amazon.com/creatorsapi (Credentials).
AMAZON_CREATORS_CREDENTIAL_ID=
AMAZON_CREATORS_CREDENTIAL_SECRET=
# Credential version: 3.1 (NA, LWA credentials) or 2.1 (NA, older Cognito credentials).
AMAZON_CREATORS_VERSION=3.1
AMAZON_CREATORS_PARTNER_TAG=sktiger-20
AMAZON_CREATORS_MARKETPLACE=www.amazon.com
