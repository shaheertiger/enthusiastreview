# Copy to .env and fill in. .env is gitignored — never commit real credentials.
# Used only by `npm run images:fetch`, which finds each product's exact Amazon listing
# through the Amazon Creators API and writes ASINs + photos to src/data/catalog.json.
# Nothing at build time or runtime reads these.
AMAZON_CREATORS_CLIENT_ID=amzn1.application-oa2-client.xxxxxxxx
AMAZON_CREATORS_CLIENT_SECRET=amzn1.oa2-cs.v1.xxxxxxxx
AMAZON_CREATORS_PARTNER_TAG=sktiger-20
