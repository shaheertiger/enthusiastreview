---
import { md as mdDefault, type Block } from '../lib/content';
// `text` formats running copy (may add affiliate and contextual links);
// `md` formats headings and table cells (no contextual links).
interface Props { blocks: Block[]; text?: (s: string) => string; md?: (s: string) => string }
const { blocks, md = mdDefault } = Astro.props;
const text = Astro.props.text ?? md;
---
{blocks.map((b) => {
  switch (b.type) {
    case 'p': return <p set:html={text(b.text)} />;
    case 'h3': return <h3 set:html={md(b.text)} />;
    case 'ul': return <ul>{b.items.map((i) => <li set:html={text(i)} />)}</ul>;
    case 'ol': return <ol>{b.items.map((i) => <li set:html={text(i)} />)}</ol>;
    case 'checklist':
      return (
        <ul class="checklist">
          {b.items.map((i) => (
            <li>
              <span class="tick" aria-hidden="true">✔</span> <strong>{i.label}:</strong> <span set:html={text(i.text)} />
              {i.sub && <ul>{i.sub.map((s) => <li set:html={text(s)} />)}</ul>}
            </li>
          ))}
        </ul>
      );
    case 'table':
      return (
        <div class="tbl-wrap">
          <table class="tbl">
            {b.caption && <caption>{b.caption}</caption>}
            <thead><tr>{b.head.map((h) => <th scope="col">{h}</th>)}</tr></thead>
            <tbody>{b.rows.map((r) => <tr>{r.map((c) => <td set:html={md(c)} />)}</tr>)}</tbody>
          </table>
        </div>
      );
    case 'callout':
      return (
        <aside class="callout">
          {b.title && <div class="ct">{b.title}</div>}
          <p set:html={text(b.text)} />
        </aside>
      );
    case 'stats':
      return <div class="stats">{b.items.map((s) => <div class="stat"><b>{s.value}</b><span set:html={md(s.label)} /></div>)}</div>;
    default: return null;
  }
})}
