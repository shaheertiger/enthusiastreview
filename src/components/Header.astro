---
import LogoMark from './LogoMark.astro';
import { PAGES, pathOf, byCategory } from '../lib/content';
import { SITE } from '../data/site';
const here = Astro.url.pathname;
const NAV = [
  { label: 'Best Picks', href: '/best/' },
  { label: 'Basements', href: '/best/best-dehumidifier-for-basement/' },
  { label: 'Crawl Spaces', href: '/best/best-crawl-space-dehumidifier/' },
  { label: 'Whole House', href: '/best/best-whole-house-dehumidifier/' },
  { label: 'Brands', href: '/best/#brands' },
  { label: 'Buying Guides', href: '/guides/' },
  { label: 'Fixes', href: '/guides/#how-to-fixes' },
  { label: 'Comparisons', href: '/compare/' },
];
const groups = byCategory(PAGES);
const anchor = (c: string) => c.toLowerCase().replace(/&/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const hubFor = (c: string) => (c === 'Comparisons' ? '/compare/' : c === 'How-To & Fixes' || c === 'Buying Advice' ? '/guides/' : '/best/');
---
<a class="skip" href="#main">Skip to content</a>
<div class="topbar">
  <div class="wrap">
    <span>{SITE.tagline}</span>
    <nav class="tb-links" aria-label="Site"><a href="/about/">About Us</a><a href="/how-we-review/">How We Review</a><a href="/disclosure/">Disclosure</a></nav>
  </div>
</div>
<header class="site-header">
  <div class="wrap">
    <button class="menu-btn" type="button" aria-label="Open menu" aria-controls="drawer" onclick="document.getElementById('drawer').classList.add('open')">
      <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="2" /></svg>
      <span class="sr-only">Menu</span>
    </button>
    <a class="logo" href="/" aria-label={`${SITE.name} home`}><LogoMark /><span class="logo-text">Enthusiast<span>Review</span></span></a>
    <a class="search-btn" href="/best/">Reviews</a>
  </div>
</header>
<nav class="navstrip" aria-label="Main">
  <ul>{NAV.map((n) => <li><a href={n.href} aria-current={here === n.href ? 'page' : undefined}>{n.label}</a></li>)}</ul>
</nav>
<div id="drawer" class="drawer" onclick="if(event.target===this)this.classList.remove('open')">
  <div class="drawer-panel" role="dialog" aria-label="Menu">
    <button class="close" type="button" aria-label="Close menu" onclick="document.getElementById('drawer').classList.remove('open')">×</button>
    <h3>Sections</h3>
    <a href="/">Home</a><a href="/best/">Best Picks</a><a href="/guides/">Buying Guides</a><a href="/compare/">Comparisons</a>
    {groups.map((g) => (
      <>
        <h3><a href={`${hubFor(g.category)}#${anchor(g.category)}`} style="border:0;padding:0;font-size:inherit;color:inherit">{g.category}</a></h3>
        {g.pages.slice(0, 6).map((p) => <a href={pathOf(p)}>{p.navLabel ?? p.h1}</a>)}
      </>
    ))}
  </div>
</div>
