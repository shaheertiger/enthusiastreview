---
import LogoMark from './LogoMark.astro';
import { SITE } from '../data/site';
import { CATEGORIES } from '../data/categories';
import { GUIDES, guidePath } from '../lib/data';
const here = Astro.url.pathname;
const NAV = [
  { label: 'Graphics Cards', href: '/best-graphics-card/' },
  { label: 'CPUs', href: '/best-cpu-for-gaming/' },
  { label: 'Coolers', href: '/best-cpu-cooler/' },
  { label: 'Power Supplies', href: '/best-power-supply/' },
  { label: 'Cases', href: '/best-pc-case/' },
  { label: 'Best Lists', href: '/best-of/' },
  { label: 'All Gear', href: '/gear/' },
  { label: 'Compare', href: '/compare/' },
  { label: 'Tools', href: '/tools/' },
  { label: 'Brands', href: '/brands/' },
];
---
<a class="skip" href="#main">Skip to content</a>
<div class="topbar">
  <div class="wrap">
    <span>{SITE.tagline}</span>
    <nav class="tb-links" aria-label="Site"><a href="/about/">About Us</a><a href="/how-we-review/">How We Score</a><a href="/disclosure/">Disclosure</a></nav>
  </div>
</div>
<header class="site-header">
  <div class="wrap">
    <button class="menu-btn" type="button" aria-label="Open menu" aria-controls="drawer" onclick="document.getElementById('drawer').classList.add('open')">
      <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="2" /></svg>
      <span class="sr-only">Menu</span>
    </button>
    <a class="logo" href="/" aria-label={`${SITE.name} home`}><LogoMark /><span class="logo-text">Enthusiast<span>Review</span></span></a>
    <a class="search-btn" href="/best-of/">Best Lists</a>
  </div>
</header>
<nav class="navstrip" aria-label="Main">
  <ul>{NAV.map((n) => <li><a href={n.href} aria-current={here === n.href ? 'page' : undefined}>{n.label}</a></li>)}</ul>
</nav>
<div id="drawer" class="drawer" onclick="if(event.target===this)this.classList.remove('open')">
  <div class="drawer-panel" role="dialog" aria-label="Menu">
    <button class="close" type="button" aria-label="Close menu" onclick="document.getElementById('drawer').classList.remove('open')">×</button>
    <p class="drawer-h">Sections</p>
    <a href="/">Home</a><a href="/best-of/">Best Lists</a><a href="/gear/">All Gear</a><a href="/compare/">Comparisons</a><a href="/tools/">Tools</a><a href="/glossary/">Glossary</a><a href="/brands/">Brands</a>
    {CATEGORIES.map((c) => (
      <>
        <p class="drawer-h">{c.label}</p>
        {GUIDES.filter((g) => g.category === c.key).map((g) => <a href={guidePath(g)}>{g.h1}</a>)}
        <a href={`/gear/#${c.key}`}>All {c.plural}</a>
      </>
    ))}
  </div>
</div>
