---
import LogoMark from './LogoMark.astro';
import { SITE } from '../data/site';
import { CATEGORIES } from '../data/categories';
const year = new Date().getFullYear();
---
<section class="newsletter">
  <div class="col">
    <p class="nl-h">Build it right the first time.</p>
    <p>Spec-sheet maths, platform gotchas and honest picks for every part in your PC. No paid placements, ever.</p>
    <a class="btn-ghost" href="/best-of/">Browse every best list</a>
  </div>
</section>
<footer class="site-footer">
  <div class="wrap">
    <div class="f-top">
      <div>
        <a class="logo" href="/" style="justify-content:flex-start"><LogoMark /><span class="logo-text">Enthusiast<span style="color:#53c2be">Review</span></span></a>
        <p style="margin-top:.75rem">{SITE.tagline}. Every pick is researched against the spec sheet, platform requirements, independent measurements and owner reports.</p>
      </div>
      <div><h4>Categories</h4><ul>
        {CATEGORIES.map((c) => <li><a href={`/${c.hero}/`}>{c.label}</a></li>)}
      </ul></div>
      <div><h4>Explore</h4><ul>
        <li><a href="/best-of/">Best Lists</a></li>
        <li><a href="/gear/">All Gear</a></li>
        <li><a href="/compare/">Comparisons</a></li>
        <li><a href="/tools/bottleneck-calculator/">Bottleneck Calculator</a></li>
        <li><a href="/tools/psu-calculator/">PSU Calculator</a></li>
        <li><a href="/glossary/">Glossary</a></li>
        <li><a href="/brands/">Brands</a></li>
      </ul></div>
      <div><h4>Company</h4><ul>
        <li><a href="/about/">About Us</a></li>
        <li><a href="/how-we-review/">How We Score</a></li>
        <li><a href="/contact/">Contact</a></li>
        <li><a href="/disclosure/">Affiliate Disclosure</a></li>
        <li><a href="/privacy/">Privacy Policy</a></li>
      </ul></div>
    </div>
    <div class="f-bottom">
      <p>{SITE.name} participates in the Amazon Services LLC Associates Program and other affiliate programs, which means we may earn commissions on products purchased through our links to retailer sites. As an Amazon Associate we earn from qualifying purchases.</p>
      <p>© {year} {SITE.name}. All rights reserved.</p>
    </div>
  </div>
</footer>
