---
// Footer in the sister-site structure: identity block with the affiliate line,
// then Categories and Company columns, then the copyright line.
import LogoMark from './LogoMark.astro';
import { SITE } from '../data/site';
import { CATEGORIES } from '../data/categories';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap">
    <div class="f-top">
      <div class="f-about">
        <a class="logo" href="/"><LogoMark /><span class="logo-text">Enthusiast<span>Review</span></span></a>
        <p>{SITE.tagline}. Every part is matched to the build it suits, scored against the spec sheet, platform requirements, independent measurements and owner reports.</p>
        <p>As an Amazon Associate we earn from qualifying purchases. Rankings are never sold. <a href="/disclosure/">How we make money</a></p>
      </div>
      <div><h4>Categories</h4><ul>
        {CATEGORIES.map((c) => <li><a href={`/${c.hero}/`}>{c.label}</a></li>)}
        <li><a href="/best-of/">All Best Lists</a></li>
      </ul></div>
      <div><h4>Database</h4><ul>
        <li><a href="/gear/">All PC Gear</a></li>
        <li><a href="/brands/">Brands</a></li>
        <li><a href="/compare/">Compare Two Products</a></li>
        <li><a href="/glossary/">Glossary</a></li>
        <li><a href="/tools/bottleneck-calculator/">Bottleneck Calculator</a></li>
        <li><a href="/tools/psu-calculator/">PSU Calculator</a></li>
      </ul></div>
      <div><h4>Company</h4><ul>
        <li><a href="/about/">About Us</a></li>
        <li><a href="/how-we-review/">How We Score</a></li>
        <li><a href="/disclosure/">Affiliate Disclosure</a></li>
        <li><a href="/privacy/">Privacy Policy</a></li>
        <li><a href="/contact/">Contact</a></li>
        <li><a href="/sitemap.xml">Sitemap</a></li>
      </ul></div>
    </div>
    <div class="f-bottom">
      <p>© {year} {SITE.name}. Product details and availability can change; check the retailer before you buy.</p>
    </div>
  </div>
</footer>
