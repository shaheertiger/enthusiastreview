---
import LogoMark from './LogoMark.astro';
import { SITE } from '../data/site';
const year = new Date().getFullYear();
---
<section class="newsletter">
  <div class="col">
    <h3>Breathe easier at home.</h3>
    <p>Straight answers on humidity, mold and the machines that fix them — no sponsored rankings, ever.</p>
    <a class="btn-ghost" href="/best/">Browse every guide</a>
  </div>
</section>
<footer class="site-footer">
  <div class="wrap">
    <div class="f-top">
      <div>
        <a class="logo" href="/" style="justify-content:flex-start"><LogoMark /><span class="logo-text">Enthusiast<span style="color:#53c2be">Review</span></span></a>
        <p style="margin-top:.75rem">{SITE.tagline}. We research every pick against DOE ratings, ENERGY STAR data, recall notices and owner reviews.</p>
      </div>
      <div><h4>Best Picks</h4><ul>
        <li><a href="/best/best-dehumidifier/">Best Dehumidifier</a></li>
        <li><a href="/best/best-dehumidifier-for-basement/">Basements</a></li>
        <li><a href="/best/best-crawl-space-dehumidifier/">Crawl Spaces</a></li>
        <li><a href="/best/best-small-dehumidifier/">Small Spaces</a></li>
        <li><a href="/best/best-dehumidifier-brands/">Brands</a></li>
      </ul></div>
      <div><h4>Guides</h4><ul>
        <li><a href="/guides/dehumidifier-size-guide/">Size Guide</a></li>
        <li><a href="/guides/dehumidifier-humidistat-settings-guide/">Humidity Settings</a></li>
        <li><a href="/guides/how-much-electricity-does-a-dehumidifier-use/">Running Costs</a></li>
        <li><a href="/guides/dehumidifier-not-working/">Troubleshooting</a></li>
        <li><a href="/compare/">Comparisons</a></li>
      </ul></div>
      <div><h4>About</h4><ul>
        <li><a href="/about/">About Us</a></li>
        <li><a href="/how-we-review/">How We Review</a></li>
        <li><a href="/contact/">Contact</a></li>
        <li><a href="/disclosure/">Affiliate Disclosure</a></li>
        <li><a href="/privacy/">Privacy Policy</a></li>
      </ul></div>
    </div>
    <div class="f-bottom">
      <p>{SITE.name} participates in the Amazon Services LLC Associates Program and other affiliate programs, which means we may earn commissions on products purchased through our links to retailer sites. As an Amazon Associate we earn from qualifying purchases.</p>
      <p>© {year} {SITE.name}. All rights reserved.</p>
    </div>
  </div>
</footer>
