---
// Product photo when we have one; otherwise a neutral drawn dehumidifier with the brand name.
interface Props { src?: string; alt: string; label?: string; eager?: boolean }
const { src, alt, label = '', eager = false } = Astro.props;
const brand = label.split(/[\s(]/)[0].slice(0, 12).toUpperCase();
---
{src ? (
  <img src={src} alt={alt} loading={eager ? 'eager' : 'lazy'} decoding="async" width="500" height="500" referrerpolicy="no-referrer" />
) : (
  <svg viewBox="0 0 120 150" role="img" aria-label={alt}>
    <rect x="18" y="8" width="84" height="128" rx="10" fill="#fff" stroke="#1f1f1f" stroke-width="2.5" />
    <rect x="30" y="20" width="60" height="10" rx="3" fill="#e3f5f4" stroke="#1f1f1f" stroke-width="1.5" />
    {[44, 52, 60, 68, 76].map((y) => <line x1="32" x2="88" y1={y} y2={y} stroke="#1f1f1f" stroke-width="2" stroke-linecap="round" />)}
    <rect x="28" y="92" width="64" height="34" rx="4" fill="#e3f5f4" stroke="#1f1f1f" stroke-width="1.5" />
    <path d="M60 99c-3 4-5 6.5-5 9.5a5 5 0 0 0 10 0c0-3-2-5.5-5-9.5z" fill="#53c2be" />
    <text x="60" y="146" text-anchor="middle" font-family="Barlow Semi Condensed, Arial, sans-serif" font-weight="700" font-size="11" fill="#525252">{brand}</text>
  </svg>
)}
