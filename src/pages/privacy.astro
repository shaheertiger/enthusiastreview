---
import Prose from '../components/Prose.astro';
import { SITE } from '../data/site';
---
<Prose title="Privacy Policy" h1="Privacy Policy" description="How Enthusiast Review handles data: cookie-free Vercel Web Analytics, affiliate links to Amazon, and no newsletter or account data collected on this site.">
  <p>This policy explains what happens to your data when you visit {SITE.name}.</p>
  <h2>Analytics</h2>
  <p>We use Vercel Web Analytics to count page views. It does not use cookies and does not track you across other websites.</p>
  <h2>Affiliate links</h2>
  <p>When you click a product link, you leave this site for the retailer (usually Amazon). The retailer may set cookies to credit the referral to us; their privacy policy applies from that point.</p>
  <h2>Email</h2>
  <p>If you email us, we use your address only to reply.</p>
  <h2>Contact</h2>
  <p>Questions about this policy: <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.</p>
</Prose>
