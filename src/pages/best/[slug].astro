---
import Article from '../../components/Article.astro';
import { pagesIn, type Page } from '../../lib/content';

export function getStaticPaths() {
  return pagesIn('best').map((page) => ({ params: { slug: page.slug }, props: { page } }));
}
const { page } = Astro.props as { page: Page };
---
<Article page={page} />
